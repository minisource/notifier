# ===========================================
# Notifier Frontend — Real Backend Config
# ===========================================
# This .env is configured for real backend integration.
# Mock mode is OFF — all API calls go to the real Notifier backend.
# ===========================================

# ========== Application ==========
NEXT_PUBLIC_APP_NAME=Notifier Admin
NEXT_PUBLIC_APP_URL=http://localhost:3004
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ========== API Mode ==========
# real = connect to actual notifier backend
NEXT_PUBLIC_API_MODE=real

# ========== Backend API ==========
# Notifier Backend API base URL (commented out to allow dynamic runtime pathing in docker)
NEXT_PUBLIC_NOTIFIER_API_URL=http://localhost:8080/v1

# General API URL (used by legacy client modules, commented out to allow dynamic runtime pathing in docker)
NEXT_PUBLIC_API_URL=http://localhost:8080/v1

# API timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT=30000

# ========== Mock Data ==========
# Must be false in production — disables centralized mock data
NEXT_PUBLIC_NOTIFIER_USE_MOCKS=false

# ========== Mock Auth (temporary bridge) ==========
# Mock auth adapter is still active until real Auth service is built.
# The adapter provides session context (userId, tenantId, roles) that
# the frontend sends as headers to the backend.
# Backend auth must be DISABLED or accept these mock tokens in dev.
NEXT_PUBLIC_NOTIFIER_MOCK_AUTH_ENABLED=false
NEXT_PUBLIC_NOTIFIER_MOCK_ACCESS_TOKEN=mock-token-notifier-admin
NEXT_PUBLIC_NOTIFIER_MOCK_USER_ID=user-mock-001
NEXT_PUBLIC_NOTIFIER_MOCK_TENANT_ID=tenant-default
NEXT_PUBLIC_NOTIFIER_MOCK_PROJECT_ID=project-default
NEXT_PUBLIC_NOTIFIER_MOCK_ROLES=admin,operator

# ========== Realtime / Polling ==========
# Mode: websocket | sse | polling | disabled
NEXT_PUBLIC_NOTIFIER_REALTIME_MODE=polling
# WebSocket/SSE endpoint URL (ignored when mode=polling)
NEXT_PUBLIC_NOTIFIER_REALTIME_URL=
# Poll interval in milliseconds (used when mode=polling)
NEXT_PUBLIC_NOTIFIER_REALTIME_POLL_INTERVAL=30000

# WebSocket URL for legacy use-websocket hook (commented out to allow dynamic runtime pathing in docker)
# NEXT_PUBLIC_WS_URL=ws://localhost:9002

# ========== Live Toasts ==========
NEXT_PUBLIC_NOTIFIER_SHOW_LIVE_TOASTS=true

# ========== Feature Flags ==========
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_PWA=true

# Auth service API (through Gateway)
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8080/v1
