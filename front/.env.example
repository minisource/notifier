# ===========================================
# Notifier Admin Frontend - Environment Variables
# ===========================================

# ========== Application ==========
NEXT_PUBLIC_APP_NAME=Notifier Admin
NEXT_PUBLIC_APP_URL=http://localhost:3004
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_DEFAULT_LOCALE=en


# ========== Backend API ==========
NEXT_PUBLIC_NOTIFIER_API_URL=http://localhost:9002/v1

# ========== Auth ==========
# Enables authentication through the Auth service.
# true  = require login via Auth service (backend must run with AUTH_ENABLED=true)
# false = run the Notifier standalone without Auth (backend must run with AUTH_ENABLED=false)
NEXT_PUBLIC_NOTIFIER_AUTH_ENABLED=true
# Optional: identity used by the local admin session when AUTH_ENABLED=false.
# NEXT_PUBLIC_NOTIFIER_LOCAL_USER_ID=local-admin
# NEXT_PUBLIC_NOTIFIER_LOCAL_EMAIL=admin@local
# NEXT_PUBLIC_NOTIFIER_LOCAL_NAME=Local Admin


# ========== Realtime / Polling ==========
NEXT_PUBLIC_NOTIFIER_REALTIME_MODE=polling
NEXT_PUBLIC_NOTIFIER_REALTIME_URL=
NEXT_PUBLIC_NOTIFIER_REALTIME_POLL_INTERVAL=30000

# ========== Live Toasts ==========
NEXT_PUBLIC_NOTIFIER_SHOW_LIVE_TOASTS=true
